{
  "backends": {
    "local-gpu": {
      "kind": "command",
      "command": ["python", "run_model.py", "{image}", "{out}"],
      "license": "hunyuan-community",
      "version": "2.1",
      "timeout": 1800
    },
    "hosted": {
      "kind": "job",
      "submit_url": "https://api.example.com/v1/image-to-3d",
      "status_url": "https://api.example.com/v1/image-to-3d/{id}",
      "token_env": "IMAGE3D_API_KEY",
      "license": "service-terms"
    }
  }
}
